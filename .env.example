# Network Anomaly Spotter - Environment Variables
# Copy this file to .env and fill in your values.

# ---- Database ----
# Default: SQLite file in the project root
DATABASE_URL=sqlite:///./network_anomaly.db

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Backend URL (used by frontend) ----
BACKEND_URL=http://localhost:8000

# ---- LLM Integration (Teammate 4 - OPTIONAL) ----
# The application works 100% without these via the deterministic fallback engine.
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai    # or: groq | anthropic
