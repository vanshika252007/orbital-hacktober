{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "device_id",
    "device_name",
    "risk_score",
    "severity",
    "status",
    "detected_at",
    "primary_reason",
    "signals_count",
    "signals"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_name": {
      "type": "string"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "INVESTIGATING", "RESOLVED", "FALSE_POSITIVE"]
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "primary_reason": {
      "type": "string"
    },
    "signals_count": {
      "type": "integer",
      "minimum": 0
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "type",
        "severity",
        "measured_value",
        "baseline_value",
        "deviation_factor",
        "explanation"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "measured_value": {
          "type": "number"
        },
        "baseline_value": {
          "type": "number"
        },
        "deviation_factor": {
          "type": "number"
        },
        "explanation": {
          "type": "string"
        }
      }
    }
  }
}
